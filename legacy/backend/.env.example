# Copy to .env and edit. Every setting is optional.
APP_NAME="AE Capture Desk API"
STUDY_ID=HACKRU-AE-001
SITE_NAME="Rutgers Demo Research Site"

# SQLite file in the backend folder by default. For Postgres:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./ae_capture.db

# Load synthetic demo patients/notes/check-ins on first start (when the DB is empty)
SEED_ON_STARTUP=true

# Comma-separated frontend origins, or * for any (fine for the demo)
CORS_ORIGINS=*

# Hours the site has to report a serious AE after becoming aware of it
SAE_REPORT_HOURS=24

# Presage SmartSpectra: minimum sample confidence (0-100) to use a pulse / breathing value
PRESAGE_MIN_PULSE_CONFIDENCE=40
PRESAGE_MIN_BREATHING_CONFIDENCE=45
