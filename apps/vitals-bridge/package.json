{
  "name": "interim-vitals-bridge",
  "version": "0.1.0",
  "description": "Interim vitals bridge: pluggable contactless-vitals sources (mock now; Presage/Arduino slots) -> timing gates -> WebSocket to the kiosk + batched eSource POSTs to the API",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/cli.js",
  "bin": {
    "interim-vitals-bridge": "dist/cli.js"
  },
  "scripts": {
    "bridge": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "ulid": "3.0.1",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "@types/ws": "8.5.13",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.0",
    "vitest": "2.1.8"
  }
}
