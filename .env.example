# ---- Interim: copy to .env and adjust. No secrets are required for the demo. ----

# API
API_HOST=0.0.0.0
API_PORT=8000
# SQLite by default. Postgres example: postgresql+psycopg://interim:interim@db:5432/interim
DATABASE_URL=sqlite:///./data/runtime/interim.db
# Shared demo password for the three seeded users (coordinator, investigator, admin).
DEMO_PASSWORD=interim-demo
# Secret used to sign session tokens. Change in any real deployment.
AUTH_SECRET=change-me-in-production
# Optional shared secret the vitals bridge sends as X-Bridge-Token. Empty = not enforced.
BRIDGE_TOKEN=
# Comma-separated CORS origins for the web app in dev.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Seed the demo study/participants on first start if the DB is empty.
SEED_ON_START=true
# Demo study to display (public ClinicalTrials.gov record, cached under data/public/).
DEMO_NCT_ID=NCT03088540

# Vitals bridge (runs on the kiosk machine)
VITALS_SOURCE=mock            # mock | presage | arduino
VITALS_SCENARIO=resting       # resting | post_exercise | tachypnea | low_quality | dropout
VITALS_MIN_CONF=0.6
BRIDGE_WS_PORT=8787
BRIDGE_API_URL=http://localhost:8000
# Arduino source only (stub): serial port of the sensor sketch.
SERIALPORT=
# Presage source only (stub): API key from physiology.presagetech.com.
PRESAGE_API_KEY=

# Web (Vite). The web app talks to the API via /api (dev proxy or nginx) and to the bridge over WS.
VITE_BRIDGE_WS_URL=ws://localhost:8787
